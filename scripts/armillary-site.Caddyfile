# armillary.zojer.studio — the Astro-rendered wiki.
#
# This is the site block appended to the app box /etc/caddy/Caddyfile.
# Kept in-repo so the routing rules travel with the code that produced them.
# The files it serves come from scripts/deploy-web.sh (rsync -> /opt/armillary-site/web).
#
# Astro static build layout this depends on:
#   /index.html, /start/index.html, /wiki/index.html   — pre-rendered pages
#   /wiki/<id>/index.html                              — one per essay
#   /404.html                                          — the not-found page
#   /_astro/**                                         — content-hashed CSS/JS
#
# HTTP-01 TLS (no DNS token needed).

armillary.zojer.studio {
	root * /opt/armillary-site/web
	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		-Server
	}

	# Content-hashed assets are immutable — cache hard.
	@immutable path /_astro/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Exact file, then the directory index. Every real route is a directory
	# with an index.html (Astro's static build format) or an exact file
	# (assets), so that's all that's needed here — no `{path}.html`
	# fallback. That fallback used to let a request for the literal path
	# `/404` match the flat `dist/404.html` file directly and get served
	# with a 200, instead of falling through to handle_errors below. An
	# unresolved path 404s from file_server and is caught below — so a
	# genuinely-missing route (including /404 itself) returns a real 404,
	# not a 200 wearing the not-found page.
	handle {
		try_files {path} {path}/index.html
		file_server
	}

	handle_errors {
		# The site-level `header` block above does not apply to responses
		# generated here — handle_errors runs its own handler chain — so
		# error responses (including this one) repeat it explicitly.
		header {
			Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			-Server
		}
		rewrite * /404.html
		file_server
	}
}
