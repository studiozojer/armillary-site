---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const essays = await getCollection('wiki');
  return essays.map((essay) => ({
    params: { id: essay.id },
    props: { essay },
  }));
}

const { essay } = Astro.props;
const { Content } = await render(essay);
---

<Base title={essay.data.title} description={essay.data.description}>
  <h1>{essay.data.title}</h1>
  <p class="lede">{essay.data.description}</p>
  <Content />
  <p><a href="/wiki/">← all essays</a></p>
</Base>
